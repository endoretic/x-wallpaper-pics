# 本地: 直接在仓库根目录的 .env 里填 (main.py 会自动加载)
# CI  : 不读任何 .env, 值来自 repository secrets / variables

# ---------- 目标用户 ----------
TARGET_USER=目标用户名

# ---------- X (推特) cookie ----------
# 唯一来源: 本地填这里, CI 用 Secret X_COOKIE
# 浏览器里整行 cookie 直接粘进来也行, 只会取 auth_token 与 ct0 两项
X_COOKIE=auth_token=你的值; ct0=你的值;

# ---------- 输出 ----------
# 本地模式的保存目录, 留空 = 脚本所在目录
SAVE_PATH=
# 是否同时下载视频 (1=是)
HAS_VIDEO=0
# 单次最多下载多少份 (0=不限)
MAX_MEDIA=0
# 并发下载数
MAX_CONCURRENT_REQUESTS=8
# 代理, 例如 http://127.0.0.1:7890
PROXY=

# ---------- Cloudflare R2 (只有 --sync-r2 模式需要) ----------
R2_ENDPOINT=https://你的ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=你的桶名
R2_ACCESS_KEY_ID=你的AccessKeyID
R2_SECRET_ACCESS_KEY=你的SecretAccessKey
# 桶内根前缀, 留空 = 直接放在桶根目录
R2_PREFIX=

# ---------- 增量同步行为 ----------
# 状态里保留多少条已处理推文 ID
MAX_KNOWN_IDS=1000
# 首次运行 / FORCE_FULL=1 时最多翻几页做历史回填 (每页最多 500 条推文)
FULL_SYNC_PAGES=1
# 置 1 忽略已有状态重新全量扫描
FORCE_FULL=0

# ---------- 目录名 (同时决定 R2 里的前缀) ----------
PORTRAIT_DIR=竖屏
LANDSCAPE_DIR=横屏方图

# ---------- 其他 ----------
# .env 文件名 (只在本地生效, CI 里没有该文件)
ENV_FILE=.env

# ---------- 壁纸 API (Cloudflare Worker, 只作本地记录, main.py 不使用) ----------
# 手机端填这个; 同一个值要设为 Worker secret (npx wrangler secret put WALLPAPER_ACCESS_TOKEN)
WALLPAPER_ACCESS_TOKEN=
