<?xml version="1.0" encoding="utf-8"?>
<!-- 设置 (含访问 token) 不进云备份, 也不随换机迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
